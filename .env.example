# MongoDB Atlas Connection
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/touroholic?retryWrites=true&w=majority

# NextAuth / JWT Authentication Secret
AUTH_SECRET=touroholic-production-secret-change-this-to-a-secure-random-32-char-string

# App Base URL (Set to https://tourholic.vercel.app in production)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Brevo (Sendinblue) Transactional Email Delivery (https://api.brevo.com/v3/smtp/email)
BREVO_API_KEY=xkeysib-your-brevo-v3-api-key-here
BREVO_SENDER_EMAIL=concierge@touroholic.com
BREVO_SENDER_NAME="Touroholic Expeditions"

# Payment Policy & Reminders
PAYMENT_DUE_DAYS=3
CRON_SECRET=touroholic-cron-secret-replace-in-production

# Image Hosting (Cloudinary configuration)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=

# Unsplash (Optional API key for live search queries)
UNSPLASH_ACCESS_KEY=

# Demo Payment Provider (Optional)
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=
