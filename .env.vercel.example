# ==============================================================================
# Touroholic Vercel Environment Variables Template (.env.vercel.example)
#
# INSTRUCTIONS:
# In Vercel Project Settings -> Environment Variables, enter each variable below
# as an individual Key-Value pair for the 'Production' (and optionally 'Preview')
# environment. Do NOT paste this file directly; use the exact keys below.
# ==============================================================================

# [REQUIRED FOR PRODUCTION]
# MongoDB Atlas Connection String
# Used by: Mongoose connection pool in serverless functions (lib/db/mongodb.ts)
# Format: mongodb+srv://<username>:<password>@<cluster-host>/<database-name>?retryWrites=true&w=majority
# Notes: Ensure MongoDB Atlas Network Access has IP 0.0.0.0/0 whitelisted for Vercel functions.
MONGODB_URI=replace_with_your_actual_value

# [REQUIRED FOR PRODUCTION]
# Cloudinary Cloud Identifier
# Used by: Server-side media upload & asset deletion pipelines (lib/images/cloudinary.ts)
CLOUDINARY_CLOUD_NAME=replace_with_your_actual_value

# [REQUIRED FOR PRODUCTION]
# Cloudinary API Public Key
# Used by: Server-side signed media operations and API health verification
CLOUDINARY_API_KEY=replace_with_your_actual_value

# [REQUIRED FOR PRODUCTION]
# Cloudinary API Secret Key
# Used by: Server-side authentication and signature generation. NEVER prefix with NEXT_PUBLIC_.
CLOUDINARY_API_SECRET=replace_with_your_actual_value

# [REQUIRED FOR PRODUCTION]
# JWT & Session Secret Key
# Used by: Signing and verifying HttpOnly JWT session cookies (lib/auth/jwt.ts)
# Recommended: Generate a 32+ character random string (e.g., using `openssl rand -hex 32`)
AUTH_SECRET=replace_with_your_actual_value

# [RECOMMENDED FOR PRODUCTION]
# Canonical Public Web Application URL
# Used by: Public absolute URL resolution, metadata, and canonical links
# Example: https://tourholic.vercel.app or https://yourdomain.com
NEXT_PUBLIC_APP_URL=replace_with_your_actual_value
